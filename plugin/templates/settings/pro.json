{
  "model": "sonnet",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(starter-kit-*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/starter-kit/statusline.sh"
  }
}
